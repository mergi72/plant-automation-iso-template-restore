<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PlantAutomation.IsoTemplateRestore</AssemblyName>
    <Version>0.1.7</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <AutoCADRoot Condition="'$(AutoCADRoot)' == ''">C:\Program Files\Autodesk\AutoCAD 2027</AutoCADRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd" HintPath="$(AutoCADRoot)\AcCoreMgd.dll" Private="false" />
    <Reference Include="AcDbMgd" HintPath="$(AutoCADRoot)\AcDbMgd.dll" Private="false" />
    <Reference Include="AcMgd" HintPath="$(AutoCADRoot)\AcMgd.dll" Private="false" />
  </ItemGroup>
</Project>
